# 로컬은 이 파일을 .env.local 로 복사해 쓰고,
# 배포는 Vercel Settings -> Environment Variables 에 같은 값을 또 넣는다.
# 하나 추가할 때마다 양쪽. 이걸 빠뜨리는 게 "배포하면 안 돼요"의 2위 원인이다.

# Day 7
MONGODB_URI=mongodb+srv://아이디:비밀번호@클러스터주소/?retryWrites=true&w=majority
MONGODB_DB=dulkkot_study

# Day 10
# AUTH_SECRET 은 아래 명령으로 만든다:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# `npx auth secret` 은 쓰지 말 것. BETTER_AUTH_SECRET 이라는 다른 이름으로 써서
# AUTH_SECRET 이 빈 채로 남고, 로그인할 때 MissingSecret 으로 터진다.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# Day 9
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# 메일 로그인 (매직 링크). 넷 다 채워야 켜진다. 비우면 구글 로그인만 뜬다.
# Gmail 이면 2단계 인증을 켜고 '앱 비밀번호'를 만들어 EMAIL_PASS 에 넣는다.
#   https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=들꽃 스터디 <your@gmail.com>

# 운영
STUDY_DAY1_DATE=2026-08-03
DISCORD_WEBHOOK_URL=
